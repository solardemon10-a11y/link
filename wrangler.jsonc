/**
 * Wrangler 설정. (예전 wrangler.toml 은 삭제됨 — 설정 파일은 이 하나만 둔다)
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multilink",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "multilink_db",
      "database_name": "multilink-db",
      "database_id": "1948bd65-eb8d-45ff-9d81-9c74f7ee9222",
      "migrations_dir": "migrations"
    }
  ]

  /**
   * 관리자 인증(Basic Auth) 비밀번호는 secret 으로 등록한다:
   *   npx wrangler secret put ADMIN_PASSWORD
   * 로컬 개발은 .dev.vars 참고.
   */
}
