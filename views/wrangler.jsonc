/**
 * 조회수 통합 대시보드 — 독립 프로젝트 (링크 서비스와 무관한 별도 워커/DB).
 *
 * 최초 1회 (이 폴더에서):
 *   npm install
 *   npm run migrate:remote
 *   npx wrangler secret put ADMIN_PASSWORD
 *   npx wrangler secret put YOUTUBE_API_KEY      (YouTube 쓸 때)
 *   npm run deploy
 *
 * 로컬 테스트: .dev.vars 에 ALLOW_INSECURE_ADMIN="true" 를 넣고 npm run dev
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "views",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "views_db",
      "database_name": "views-db",
      "database_id": "72208e89-aa2c-43f6-8941-475a3fc7f13f",
      "migrations_dir": "migrations"
    }
  ],

  // 매시간 자동 수집 (UTC). 한 번에 외부 호출 한도(50) 안에서 "가장 오래 안 한 계정"부터 처리한다.
  // 수동 새로고침 버튼도 있음.
  "triggers": { "crons": ["0 * * * *"] }
}
