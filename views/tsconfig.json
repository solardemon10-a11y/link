{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts"
  ]
}
