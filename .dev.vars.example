# 로컬 개발용 환경변수. 이 파일을 `.dev.vars` 로 복사해서 쓴다.
# `.dev.vars` 는 .gitignore 처리돼 있고 배포에는 올라가지 않는다.

# 로컬에서는 Cloudflare Access 가 없으므로 관리자 인증을 건너뛴다.
# 배포 환경(wrangler.jsonc vars / secret)에는 절대 넣지 말 것.
ALLOW_INSECURE_ADMIN="true"

# (선택) 로컬에서 실제 Access 검증을 테스트하려면 ALLOW_INSECURE_ADMIN 을 지우고 아래를 채운다.
# CF_ACCESS_TEAM_DOMAIN="yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD="<Application Audience 태그>"
